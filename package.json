{
  "name": "tross-linkedin-profile-api",
  "version": "1.0.0",
  "description": "Hosted API that accepts a LinkedIn profile URL and returns structured JSON.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "extract:local": "tsx scripts/tryPlaywrightExtractor.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "bullmq": "^5.34.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "playwright": "^1.62.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
