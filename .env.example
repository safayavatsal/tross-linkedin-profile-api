# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Redis (cache + BullMQ backing store)
REDIS_URL=redis://localhost:6379

# Cache
PROFILE_CACHE_TTL_SECONDS=86400

# Extraction / job behavior
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_MAX_CALLS_PER_MINUTE=10

# Rate limiting (client-facing, at the API layer)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Authenticated (full-data) extraction. Leave both unset and the app still
# works via the no-login public fallback (less data). See README "Extraction layer".
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
